<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="/static/image/logomissaparo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Vérification de session sur Missa Paro.">
    <title>Missa Paro - Vérification</title>
    <%- include('partials/styles') %>
</head>

<body class="auth-page">
    <main class="auth-card" aria-labelledby="verification-title">
        <%
          const hasUid = typeof reponse !== 'undefined' && Boolean(reponse);
          const targetHref = typeof nextUrl !== 'undefined' && nextUrl ? nextUrl : '/page/tableau_bords';
        %>
        <div class="auth-brand">
            <img src="/static/image/logomissaparo.png" alt="Logo Missa Paro" class="auth-logo">
            <div class="verification-status-badge" aria-hidden="true">
                <%= hasUid ? '✓' : '…' %>
            </div>
            <h1 id="verification-title" class="page-title">
                <%= hasUid ? 'Connexion vérifiée' : 'Vérification en attente' %>
            </h1>
            <p class="auth-subtitle">
                <%= hasUid ? 'Votre identifiant de session a bien été validé.' : 'Aucune session active détectée.' %>
            </p>
        </div>

        <% if (hasUid) { %>
            <div class="alert alert-info mb-4">
                <strong>Identifiant de session :</strong> <code><%= reponse %></code>
            </div>
            <a href="<%= targetHref %>" class="btn btn-primary btn-block" data-verify-session-link>
                Continuer vers mon espace
            </a>
            <div id="session-cookie-warning" class="alert alert-warning mt-4 hidden" role="alert">
                <p>
                    Votre navigateur bloque les cookies dans cet aperçu intégré : la connexion ne peut pas être conservée dans ce cadre.
                </p>
                <a href="/" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm mt-2">
                    Ouvrir Missa Paro dans un nouvel onglet
                </a>
            </div>
        <% } else { %>
            <div class="alert alert-error mb-4" role="alert">
                Impossible de confirmer la session. Veuillez vous reconnecter.
            </div>
            <a href="/" class="btn btn-primary btn-block">
                Retour à la connexion
            </a>
        <% } %>

        <div class="auth-footer">
            <a class="auth-link" href="/">Changer de compte</a>
        </div>
    </main>
    <script src="/static/js/ui-interactions.js"></script>
</body>

</html>
