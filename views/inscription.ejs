<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="/static/image/logomissaparo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Création d’un compte Fidèle sur Missa Paro.">
    <title>Missa Paro - Inscription Fidèle</title>
    <%- include('partials/styles') %>
</head>

<body class="auth-page">
    <main class="auth-card auth-card-wide" aria-labelledby="register-title">
        <div class="auth-brand">
            <img src="/static/image/logomissaparo.png" alt="Logo Missa Paro" class="auth-logo">
            <h1 id="register-title" class="page-title">Création de votre compte Fidèle</h1>
            <p class="auth-subtitle">
                Suivez vos demandes d’intentions de messe. Les espaces paroissiaux sont créés par la Super Administration.
            </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error mb-4" role="alert">
                <%= error %>
            </div>
        <% } %>

        <form action="/page/valide" method="POST" data-loading-form data-validate-passwords>
            <fieldset class="ecclesiastical-section">
                <legend class="ecclesiastical-section-title">Paroisse habituelle de référence (Côte d’Ivoire)</legend>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="provinceId" class="form-label">Province ecclésiastique</label>
                        <select id="provinceId" name="provinceId" class="form-select" required>
                            <option value="">Sélectionnez votre province</option>
                            <% if (typeof provinces !== 'undefined' && Array.isArray(provinces)) { %>
                                <% for (const prov of provinces) { %>
                                    <option value="<%= prov.id %>"><%= prov.name %></option>
                                <% } %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="dioceseId" class="form-label">Diocèse</label>
                        <select id="dioceseId" name="dioceseId" class="form-select" required disabled>
                            <option value="">Sélectionnez votre diocèse</option>
                        </select>
                        <small id="diocese-helper" class="form-helper">Choisissez d’abord une province ecclésiastique.</small>
                    </div>
                </div>

                <div class="form-group">
                    <label for="parishId" class="form-label">Paroisse</label>
                    <div class="parish-search-wrap">
                        <label for="parish-search-input" class="sr-only">Rechercher une paroisse par nom ou localité</label>
                        <input
                            id="parish-search-input"
                            type="search"
                            class="form-control"
                            placeholder="Rechercher une paroisse (nom, commune, ville)..."
                            autocomplete="off"
                            disabled
                        >
                    </div>
                    <select id="parishId" name="parishId" class="form-select" required disabled>
                        <option value="">Sélectionnez votre paroisse</option>
                    </select>
                    <small id="parish-helper" class="form-helper">Choisissez d’abord un diocèse.</small>

                    <div id="parish-empty-state" class="alert alert-info parish-empty-box hidden" role="status">
                        <span id="parish-empty-text">Aucune paroisse trouvée pour cette recherche.</span>
                        <button id="use-missing-parish-btn" type="button" class="btn btn-secondary btn-sm">
                            Je ne trouve pas ma paroisse
                        </button>
                    </div>
                </div>

                <div id="missing-parish-box" class="card-soft card-soft-gold mb-4 hidden">
                    <div class="form-group">
                        <label for="missing_parish_name" class="form-label">Nom de votre paroisse</label>
                        <input
                            id="missing_parish_name"
                            name="missing_parish_name"
                            type="text"
                            class="form-control"
                            maxlength="120"
                            placeholder="Ex. Paroisse Saint-Jean-Baptiste de..."
                        >
                        <small class="form-helper">
                            Votre paroisse sera enregistrée comme demande en attente de validation par l’administrateur avant d’intégrer l’annuaire officiel.
                        </small>
                    </div>
                    <input id="parish_request_id" name="parish_request_id" type="hidden" value="">
                </div>

                <p id="ecclesiastical-error" class="alert alert-error mb-3 hidden" role="alert"></p>
            </fieldset>

            <div class="form-grid-2">
                <% for (const champ of champs) { %>
                    <% if (champ.type === 'select') { %>
                        <%- include('partials/select_field', { name: champ.name, label: champ.label, options: champ.options, requit: champ.required }) %>
                    <% } else { %>
                        <%- include('partials/input_field', { name: champ.name, label: champ.label, placeholder: champ.placeholder, type: champ.type, value: '', requit: champ.required, width: champ.width || null }) %>
                    <% } %>
                <% } %>
            </div>
            <p id="password-match-error" class="alert alert-error mb-3 hidden" role="alert">
                Les mots de passe ne correspondent pas.
            </p>
            <%- include('partials/bouton_envoi', { name: "Créer mon compte fidèle" }) %>
        </form>

        <div class="auth-divider">ou</div>

        <a href="/demande-intention" class="btn btn-gold btn-block">
            Déposer une intention sans compte
        </a>

        <div class="auth-footer">
            <span>Vous avez déjà un compte ?</span>
            <a class="auth-link" href="/">Se connecter</a>
        </div>
    </main>

    <script src="/static/js/ecclesiastical-selector.js"></script>
    <script src="/static/js/ui-interactions.js"></script>
</body>

</html>
