<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="/static/image/logomissaparo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Initialisation sécurisée du Super Administrateur Missa Paro.">
    <title>Missa Paro - Initialisation Super Admin</title>
    <%- include('partials/styles') %>
</head>

<body class="auth-page">
    <main class="auth-card" aria-labelledby="setup-title">
        <div class="auth-brand">
            <img src="/static/image/logomissaparo.png" alt="Logo Missa Paro" class="auth-logo">
            <h1 id="setup-title" class="page-title">Initialisation Super Administrateur</h1>
            <p class="auth-subtitle">Définissez le mot de passe initial de <strong><%= email %></strong></p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error mb-4" role="alert"><%= error %></div>
        <% } %>

        <form action="/setup-super-admin" method="POST" data-loading-form>
            <%- include('partials/input_field', { name: 'email', label: 'Email Super Administrateur', placeholder: email, type: 'email', value: email, requit: true }) %>
            <%- include('partials/input_field', { name: 'password', label: 'Mot de passe sécurisé', placeholder: 'Au moins 10 caractères recommandés', type: 'password', value: '', requit: true }) %>
            <%- include('partials/input_field', { name: 'confirmation', label: 'Confirmer le mot de passe', placeholder: 'Répétez le mot de passe', type: 'password', value: '', requit: true }) %>
            <%- include('partials/bouton_envoi', { name: 'Initialiser et ouvrir la console' }) %>
        </form>

        <div class="auth-footer">
            <a class="auth-link" href="/">Retour à l’accueil</a>
        </div>
    </main>

    <script src="/static/js/ui-interactions.js"></script>
</body>

</html>
