<%
  const perms = typeof permissions !== 'undefined' && Array.isArray(permissions) ? permissions : [];
  const currentSec = typeof activeSection !== 'undefined' && activeSection ? activeSection : 'overview';
  const menuItems = [
    { key: 'overview', perm: 'parish.dashboard.view', url: '/refresh/refresh_firt', icon: 'dashboard', label: 'Tableau de bord', id: 'reload-btn' },
    { key: 'intentions', perm: 'parish.intentions.view', url: '/refresh/refresh_second', icon: 'description', label: 'Intentions', id: 'reload-btn1' },
    { key: 'payments', perm: 'parish.payments.view', url: '/refresh/parish/payments', icon: 'payments', label: 'Paiements', id: 'nav-payments-btn' },
    { key: 'masses', perm: 'parish.masses.view', url: '/refresh/refresh_third', icon: 'church', label: 'Messes', id: 'reload-btn2' },
    { key: 'announcements', perm: 'parish.announcements.view', url: '/refresh/refresh_four', icon: 'campaign', label: 'Annonces', id: 'reload-btn3' },
    { key: 'reports', perm: 'parish.reports.view', url: '/refresh/parish/reports', icon: 'bar_chart', label: 'Statistiques', id: 'nav-reports-btn' },
    { key: 'users', perm: 'parish.users.view', url: '/refresh/parish/users', icon: 'group', label: 'Utilisateurs', id: 'nav-users-btn' },
    { key: 'roles', perm: 'parish.roles.view', url: '/refresh/parish/roles', icon: 'admin_panel_settings', label: 'Rôles & accès', id: 'nav-roles-btn' },
    { key: 'settings', perm: 'parish.settings.view', url: '/refresh/parish/settings', icon: 'settings', label: 'Paramètres', id: 'nav-settings-btn' },
    { key: 'audit', perm: 'parish.audit.view', url: '/refresh/parish/audit', icon: 'history', label: 'Historique', id: 'nav-audit-btn' },
  ];
%>
<nav id="sidebar-nav" class="sidebar-nav" aria-label="Sections du tableau de bord">
    <% for (const item of menuItems) { %>
        <% if (perms.includes(item.perm)) { const isActive = currentSec === item.key; %>
            <a
                id="<%= item.id %>"
                class="nav-link<%= isActive ? ' active' : '' %>"
                href="/page/tableau_bords?section=<%= item.key %>"
                data-refresh-url="<%= item.url %>"
                data-section="<%= item.key %>"
                <%= isActive ? 'aria-current="page"' : '' %>
            >
                <span class="material-symbols-rounded nav-icon" aria-hidden="true"><%= item.icon %></span>
                <span><%= item.label %></span>
            </a>
        <% } %>
    <% } %>
</nav>
