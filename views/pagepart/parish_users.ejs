<%- include('../partials/page_header', {
    title: 'Utilisateurs de la paroisse',
    subtitle: `Équipe pastorale et administrative rattachée à ${activeParish.name}`,
    actions: []
}) %>

<div id="parish-users-feedback" class="alert hidden mb-4" role="status"></div>

<div id="parish-member-temp-reveal" class="card-soft card-soft-gold hidden mb-4" role="region" aria-live="polite">
    <h2 class="section-title mb-2">Mot de passe temporaire généré</h2>
    <p>Communiquez ce mot de passe temporaire à l’utilisateur (changement obligatoire à la première connexion) : <code id="parish-member-temp-pass" class="credential-code"></code></p>
</div>

<% if (permissions.includes('parish.users.manage')) { %>
    <form id="parish-create-member-form" class="card-soft mb-4">
        <h2 class="section-title mb-3">Ajouter ou rattacher un membre à la paroisse</h2>
        <div class="form-grid-2">
            <div class="form-group">
                <label for="pm-displayName" class="form-label">Nom complet</label>
                <input id="pm-displayName" name="displayName" type="text" class="form-control" required placeholder="Ex. Père André Kouamé">
            </div>
            <div class="form-group">
                <label for="pm-email" class="form-label">Adresse e-mail</label>
                <input id="pm-email" name="email" type="email" class="form-control" required placeholder="membre@paroisse.ci">
            </div>
        </div>
        <div class="form-grid-2">
            <div class="form-group">
                <label for="pm-phone" class="form-label">Téléphone</label>
                <input id="pm-phone" name="phone" type="tel" class="form-control" placeholder="+225 07 00 00 00 00">
            </div>
            <div class="form-group">
                <label for="pm-title" class="form-label">Fonction affichée (optionnel)</label>
                <input id="pm-title" name="titleLabel" type="text" class="form-control" placeholder="Ex. Vicaire chargé de la catéchèse">
            </div>
        </div>
        <div class="form-group">
            <span class="form-label">Rôles initiaux cumulables</span>
            <div class="roles-checkbox-grid">
                <% for (const code of roleCodes) { %>
                    <label class="checkbox-label">
                        <input type="checkbox" name="roles" value="<%= code %>">
                        <span><%= roleCatalog[code].label %></span>
                    </label>
                <% } %>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Ajouter à la paroisse</button>
        </div>
    </form>
<% } %>

<section class="table-card" aria-label="Membres de la paroisse">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Membre &amp; Coordonnées</th>
                    <th>Rôles actifs</th>
                    <th>Compte / Appartenance</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (members && members.length > 0) { %>
                    <% for (const m of members) { %>
                        <tr>
                            <td>
                                <span class="table-cell-title"><%= m.user.displayName %></span>
                                <span class="table-cell-sub">
                                    <%= m.user.email %> · <%= m.user.phone || 'Téléphone non renseigné' %><br>
                                    Fonction : <%= m.membership.titleLabel || 'Membre paroissial' %>
                                </span>
                            </td>
                            <td>
                                <div class="roles-chip-list">
                                    <% if (m.activeRoles.length > 0) { %>
                                        <% for (const r of m.activeRoles) { %>
                                            <%- include('../partials/role_badge', { roleCode: r }) %>
                                        <% } %>
                                    <% } else { %>
                                        <span class="text-muted">Aucun rôle actif</span>
                                    <% } %>
                                </div>
                            </td>
                            <td>
                                <div class="flex items-center gap-2">
                                    <%- include('../partials/status_badge', { statut: m.user.status }) %>
                                    <%- include('../partials/status_badge', { statut: m.membership.status }) %>
                                </div>
                            </td>
                            <td>
                                <div class="table-actions">
                                    <button type="button" class="btn btn-ghost btn-sm" data-member-detail="<%= m.membership.id %>">Détails</button>
                                    <% if (permissions.includes('parish.users.manage')) { %>
                                        <button type="button" class="btn btn-outline btn-sm" data-member-edit="<%= m.membership.id %>">Modifier</button>
                                        <% if (m.membership.status === 'ACTIVE') { %>
                                            <button type="button" class="btn btn-danger btn-sm" data-parish-membership-status="SUSPENDED" data-membership-id="<%= m.membership.id %>">Suspendre accès</button>
                                        <% } else if (m.membership.status === 'SUSPENDED') { %>
                                            <button type="button" class="btn btn-primary btn-sm" data-parish-membership-status="ACTIVE" data-membership-id="<%= m.membership.id %>">Réactiver</button>
                                        <% } %>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                <% } else { %>
                    <tr>
                        <td colspan="4" class="empty-state">Aucun membre rattaché à cette paroisse.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

<%- include('../partials/member_detail_modal') %>

<% if (permissions.includes('parish.users.manage')) { %>
<div id="member-edit-modal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="member-edit-title">
    <div class="modal-dialog modal-dialog-lg">
        <div class="modal-header payment-modal-header">
            <h2 id="member-edit-title" class="modal-title">Modifier le membre paroissial</h2>
            <button type="button" class="icon-btn" data-dialog-close="member-edit-modal" aria-label="Fermer">
                <span class="material-symbols-rounded" aria-hidden="true">close</span>
            </button>
        </div>
        <form id="member-edit-form">
            <input id="me-membership-id" type="hidden" name="membershipId">
            <div class="modal-body">
                <div id="member-edit-error" class="alert alert-error hidden mb-3" role="alert"></div>
                <div class="form-group">
                    <label for="me-displayName" class="form-label">Nom complet</label>
                    <input id="me-displayName" name="displayName" type="text" class="form-control" required maxlength="120">
                </div>
                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="me-phone" class="form-label">Téléphone</label>
                        <input id="me-phone" name="phone" type="tel" class="form-control" maxlength="40" placeholder="+225 07 00 00 00 00">
                    </div>
                    <div class="form-group">
                        <label for="me-titleLabel" class="form-label">Fonction affichée</label>
                        <input id="me-titleLabel" name="titleLabel" type="text" class="form-control" maxlength="80" placeholder="Ex. Vicaire">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-dialog-close="member-edit-modal">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>
<% } %>
