<%
  const perms = typeof permissions !== 'undefined' && Array.isArray(permissions) ? permissions : [];
  const statusLabels = (stats && stats.statusLabels) ? stats.statusLabels : {};
%>
<div class="page-header">
    <div class="page-header-meta">
        <h1 class="page-title">Tableau de bord</h1>
        <p class="page-subtitle">Vue d'ensemble des intentions, messes et annonces paroissiales</p>
    </div>
    <div class="page-actions">
        <% if (perms.includes('parish.announcements.publish')) { %>
            <a href="/page/annonces" class="btn btn-outline">Nouvelle annonce</a>
        <% } %>
        <% if (perms.includes('parish.masses.manage')) { %>
            <a href="/page/messes" class="btn btn-gold">Ajouter une messe</a>
        <% } %>
    </div>
</div>

<section class="kpi-grid" aria-label="Indicateurs clés">
    <%- include('../partials/stat_card', { id: 'stat-pending-count', label: 'Intentions en attente', value: stats ? stats.pendingCount : 0, meta: 'À traiter ou programmer', icon: 'hourglass_top' }) %>
    <%- include('../partials/stat_card', { id: 'stat-validated-count', label: 'Acceptées / Programmées', value: stats ? stats.acceptedCount : 0, meta: `${stats ? stats.celebratedCount : 0} célébrée(s)`, icon: 'check_circle' }) %>
    <%- include('../partials/stat_card', { id: 'stat-messes-count', label: 'Messes à venir', value: stats ? stats.messesCount : 0, meta: 'Célébrations programmées', icon: 'church' }) %>
    <%- include('../partials/stat_card', { id: 'stat-annonces-count', label: 'Annonces', value: stats ? stats.annoncesCount : 0, meta: 'Communications paroissiales', icon: 'campaign' }) %>
</section>

<section class="dashboard-grid" aria-label="Activité et aperçu">
    <article class="panel-soft">
        <div class="chart-header">
            <div>
                <h2 class="section-title">Volume des intentions</h2>
                <p class="text-muted">Répartition des demandes reçues par la paroisse</p>
            </div>
            <strong id="stat-weekly-total" class="kpi-value text-success"><%= stats ? stats.weeklyTotal : 0 %></strong>
        </div>

        <div class="chart-bars" role="img" aria-label="Aperçu hebdomadaire des intentions">
            <div class="chart-bar-col">
                <span class="chart-bar-pct">40%</span>
                <div class="chart-bar bar-h-40" title="Lundi : 40%"></div>
                <span class="chart-day">Lun</span>
            </div>
            <div class="chart-bar-col">
                <span class="chart-bar-pct">55%</span>
                <div class="chart-bar bar-h-55" title="Mardi : 55%"></div>
                <span class="chart-day">Mar</span>
            </div>
            <div class="chart-bar-col">
                <span class="chart-bar-pct">80%</span>
                <div class="chart-bar bar-h-80" title="Mercredi : 80%"></div>
                <span class="chart-day">Mer</span>
            </div>
            <div class="chart-bar-col">
                <span class="chart-bar-pct">25%</span>
                <div class="chart-bar bar-h-25" title="Jeudi : 25%"></div>
                <span class="chart-day">Jeu</span>
            </div>
            <div class="chart-bar-col">
                <span class="chart-bar-pct">65%</span>
                <div class="chart-bar bar-h-65" title="Vendredi : 65%"></div>
                <span class="chart-day">Ven</span>
            </div>
        </div>
    </article>

    <article class="panel-soft">
        <div class="flex items-center justify-between mb-3">
            <h2 class="section-title">Intentions récentes</h2>
            <% if (perms.includes('parish.intentions.view')) { %>
                <button type="button" class="btn btn-ghost btn-sm text-primary-brand" data-nav-target="intentions">
                    Voir plus
                </button>
            <% } %>
        </div>

        <div class="table-responsive">
            <table class="data-table data-table-compact">
                <thead>
                    <tr>
                        <th>Réf.</th>
                        <th>Demandeur</th>
                        <th>Objet</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody id="recent-intentions-body">
                    <% if (stats && stats.recentIntentions && stats.recentIntentions.length > 0) { %>
                        <% for (const item of stats.recentIntentions.slice(0, 5)) { %>
                            <tr>
                                <td><code><%= item.trackingRef %></code></td>
                                <td><%= item.requesterName %></td>
                                <td><%= item.objet %></td>
                                <td><%- include('../partials/status_badge', { statut: item.status, label: statusLabels[item.status] || item.status }) %></td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="empty-state">Aucune intention enregistrée.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </article>
</section>
