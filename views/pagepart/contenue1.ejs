<!-- HEADER -->
<div class="page-header">
    <div class="page-header-meta">
        <h1 class="page-title">Tableau de bord</h1>
        <p class="page-subtitle">Vue d'ensemble des intentions, messes et annonces paroissiales</p>
    </div>
    <div class="page-actions">
        <a href="/page/annonces" class="btn btn-outline">Nouvelle annonce</a>
        <a href="/page/messes" class="btn btn-gold">Ajouter une messe</a>
    </div>
</div>

<!-- STATS -->
<section class="kpi-grid" aria-label="Indicateurs clés">
    <article class="kpi-card">
        <span class="kpi-label">Intentions en attente</span>
        <strong id="stat-pending-count" class="kpi-value"><%= stats ? stats.pendingCount : 13 %></strong>
        <span class="kpi-meta">À valider par la paroisse</span>
    </article>

    <article class="kpi-card">
        <span class="kpi-label">Intentions validées</span>
        <strong id="stat-validated-count" class="kpi-value"><%= stats ? stats.validatedCount : 88 %></strong>
        <span class="kpi-meta">Confirmées pour célébration</span>
    </article>

    <article class="kpi-card">
        <span class="kpi-label">Messes programmées</span>
        <strong id="stat-messes-count" class="kpi-value"><%= stats ? stats.messesCount : 2 %></strong>
        <span class="kpi-meta">Célébrations à venir</span>
    </article>

    <article class="kpi-card">
        <span class="kpi-label">Annonces publiées</span>
        <strong id="stat-annonces-count" class="kpi-value"><%= stats ? stats.annoncesCount : 5 %></strong>
        <span class="kpi-meta">Communications paroissiales</span>
    </article>
</section>

<!-- GRID -->
<section class="dashboard-grid" aria-label="Activité et aperçu">
    <!-- GRAPH -->
    <article class="panel-soft">
        <div class="chart-header">
            <div>
                <h2 class="section-title">Intentions de la semaine</h2>
                <p class="text-muted">Répartition hebdomadaire (données de démonstration)</p>
            </div>
            <strong id="stat-weekly-total" class="kpi-value text-success"><%= stats ? stats.weeklyTotal : 101 %></strong>
        </div>

        <div class="chart-bars" role="img" aria-label="Graphique hebdomadaire de démonstration : Lundi 40%, Mardi 55%, Mercredi 80%, Jeudi 25%, Vendredi 65%">
            <div class="chart-bar-col">
                <span class="chart-bar-pct">40%</span>
                <div class="chart-bar bar-h-40" title="Lundi : 40%"></div>
                <span class="chart-day">Lun</span>
            </div>
            <div class="chart-bar-col">
                <span class="chart-bar-pct">55%</span>
                <div class="chart-bar bar-h-55" title="Mardi : 55%"></div>
                <span class="chart-day">Mar</span>
            </div>
            <div class="chart-bar-col">
                <span class="chart-bar-pct">80%</span>
                <div class="chart-bar bar-h-80" title="Mercredi : 80%"></div>
                <span class="chart-day">Mer</span>
            </div>
            <div class="chart-bar-col">
                <span class="chart-bar-pct">25%</span>
                <div class="chart-bar bar-h-25" title="Jeudi : 25%"></div>
                <span class="chart-day">Jeu</span>
            </div>
            <div class="chart-bar-col">
                <span class="chart-bar-pct">65%</span>
                <div class="chart-bar bar-h-65" title="Vendredi : 65%"></div>
                <span class="chart-day">Ven</span>
            </div>
        </div>
    </article>

    <!-- PREVIEW TABLE -->
    <article class="panel-soft">
        <div class="flex items-center justify-between mb-3">
            <h2 class="section-title">Intentions récentes</h2>
            <button
                type="button"
                class="btn btn-ghost btn-sm text-primary-brand"
                onclick="document.getElementById('reload-btn1') && document.getElementById('reload-btn1').click()"
            >
                Voir plus
            </button>
        </div>

        <div class="table-responsive">
            <table class="data-table data-table-compact">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Horaire</th>
                        <th>Célébrant</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody id="recent-intentions-body">
                    <% if (stats && stats.recentIntentions && stats.recentIntentions.length > 0) { %>
                        <% for (const item of stats.recentIntentions.slice(0, 4)) { %>
                            <tr>
                                <td><%= item.date %></td>
                                <td><%= item.horaire %></td>
                                <td><%= item.celebrant %></td>
                                <td><%- include('../partials/status_badge', { statut: item.statut }) %></td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="empty-state">Aucune intention enregistrée.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </article>
</section>
