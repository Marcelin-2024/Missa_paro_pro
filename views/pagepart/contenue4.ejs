<%
  const perms = typeof permissions !== 'undefined' && Array.isArray(permissions) ? permissions : [];
  const annonces = (stats && stats.allAnnonces) ? stats.allAnnonces : [];
  const typeLabels = (stats && stats.annonceTypeLabels) ? stats.annonceTypeLabels : {
    evenement: 'Événement',
    Deces: 'Décès',
    Communique: 'Communiqué',
    Solennite: 'Solennité',
  };
  const canPublish = perms.includes('parish.announcements.publish');
  const canApprove = perms.includes('parish.announcements.approve');
%>
<div class="page-header">
    <div class="page-header-meta">
        <h1 class="page-title">Gestion des annonces</h1>
        <p class="page-subtitle">Consultez, publiez, modifiez et approuvez les communications paroissiales</p>
    </div>
    <div class="page-actions">
        <% if (canPublish) { %>
            <a href="/page/annonces" class="btn btn-gold">Ajouter une annonce</a>
        <% } %>
    </div>
</div>

<div id="parish-annonces-feedback" class="alert hidden mb-4" role="status"></div>

<section class="table-card" aria-label="Liste des annonces paroissiales">
    <div class="table-toolbar">
        <div class="table-filters">
            <label for="annonces-search" class="sr-only">Rechercher une annonce</label>
            <input
                id="annonces-search"
                type="search"
                class="form-control table-search"
                placeholder="Rechercher par titre ou contenu..."
                data-cards-search="annonces-cards-grid"
            >
            <label for="annonces-type-filter" class="sr-only">Filtrer par type</label>
            <select
                id="annonces-type-filter"
                class="form-select table-search"
                data-cards-filter="annonces-cards-grid"
            >
                <option value="">Tous les types</option>
                <option value="evenement">Événement</option>
                <option value="deces">Décès</option>
                <option value="communique">Communiqué</option>
                <option value="solennite">Solennité</option>
            </select>
        </div>
    </div>

    <div id="annonces-cards-grid" class="cards-grid">
        <% if (annonces.length > 0) { %>
            <% for (const item of annonces) { %>
                <article class="annonce-card" data-filter-type="<%= String(item.type || '').toLowerCase() %>">
                    <div class="annonce-card-meta">
                        <span class="badge badge-info"><%= typeLabels[item.type] || item.type %></span>
                        <span><%= item.dateAnnonce %></span>
                    </div>
                    <div class="mb-2">
                        <%- include('../partials/status_badge', { statut: item.statut }) %>
                    </div>
                    <% if (item.imageUrl) { %>
                        <img src="<%= item.imageUrl %>" alt="<%= item.titre %>" class="annonce-card-image">
                    <% } %>
                    <h2 class="annonce-card-title"><%= item.titre %></h2>
                    <p class="annonce-card-content annonce-card-content-clamp"><%= item.contenu %></p>
                    <div class="table-actions mt-3">
                        <button type="button" class="btn btn-ghost btn-sm" data-annonce-detail="<%= item.id %>">Détails</button>
                        <% if (item.statut === 'PENDING_APPROVAL' && canApprove) { %>
                            <button type="button" class="btn btn-primary btn-sm" data-approve-annonce="<%= item.id %>">Approuver</button>
                        <% } %>
                        <% if (canPublish) { %>
                            <button type="button" class="btn btn-outline btn-sm" data-annonce-edit="<%= item.id %>">Modifier</button>
                            <% if (item.statut !== 'ARCHIVED') { %>
                                <button type="button" class="btn btn-outline btn-sm" data-annonce-archive="<%= item.id %>">Archiver</button>
                            <% } %>
                            <button type="button" class="btn btn-danger btn-sm" data-annonce-delete="<%= item.id %>">Supprimer</button>
                        <% } %>
                    </div>
                </article>
            <% } %>
        <% } else { %>
            <%- include('../partials/empty_state', {
                title: 'Aucune annonce publiée',
                description: 'Publiez une première annonce pour informer les fidèles de la paroisse.',
                icon: 'campaign'
            }) %>
        <% } %>
    </div>

    <div id="annonces-cards-grid-empty" class="empty-state hidden">
        Aucune annonce ne correspond à votre recherche.
    </div>
</section>

<div id="annonce-detail-modal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="annonce-detail-title">
    <div class="modal-dialog modal-dialog-lg">
        <div class="modal-header payment-modal-header">
            <div>
                <h2 id="annonce-detail-title" class="modal-title">Détails de l’annonce</h2>
                <p id="ad-date-sub" class="text-muted">-</p>
            </div>
            <button type="button" class="icon-btn" data-dialog-close="annonce-detail-modal" aria-label="Fermer les détails">
                <span class="material-symbols-rounded" aria-hidden="true">close</span>
            </button>
        </div>

        <div class="modal-body payment-modal-body">
            <img id="ad-image" src="#" alt="Illustration de l’annonce" class="annonce-card-image hidden">
            <div class="payment-detail-card mb-3">
                <dl class="payment-detail-dl">
                    <div><dt>Type</dt><dd id="ad-type">-</dd></div>
                    <div><dt>Statut</dt><dd id="ad-statut">-</dd></div>
                    <div><dt>Date de l’annonce</dt><dd id="ad-date">-</dd></div>
                    <div><dt>Publiée par</dt><dd id="ad-created-by">-</dd></div>
                    <div><dt>Approuvée par</dt><dd id="ad-approved-by">-</dd></div>
                    <div><dt>Créée le</dt><dd id="ad-created-at">-</dd></div>
                </dl>
            </div>
            <div class="payment-detail-card">
                <h3 id="ad-titre">-</h3>
                <p id="ad-contenu" class="detail-text-block">-</p>
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-primary" data-dialog-close="annonce-detail-modal">Fermer</button>
        </div>
    </div>
</div>

<% if (canPublish) { %>
<div id="annonce-edit-modal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="annonce-edit-title">
    <div class="modal-dialog modal-dialog-lg">
        <div class="modal-header payment-modal-header">
            <h2 id="annonce-edit-title" class="modal-title">Modifier l’annonce</h2>
            <button type="button" class="icon-btn" data-dialog-close="annonce-edit-modal" aria-label="Fermer">
                <span class="material-symbols-rounded" aria-hidden="true">close</span>
            </button>
        </div>
        <form id="annonce-edit-form">
            <input id="ae-id" type="hidden" name="id">
            <div class="modal-body">
                <div id="annonce-edit-error" class="alert alert-error hidden mb-3" role="alert"></div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="ae-type" class="form-label">Type d’annonce</label>
                        <select id="ae-type" name="type" class="form-select" required>
                            <option value="evenement">Événement</option>
                            <option value="Deces">Décès</option>
                            <option value="Communique">Communiqué</option>
                            <option value="Solennite">Solennité</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="ae-date" class="form-label">Date de l’annonce</label>
                        <input id="ae-date" name="dateAnnonce" type="date" class="form-control" required>
                    </div>
                </div>

                <div class="form-group">
                    <label for="ae-titre" class="form-label">Titre de l’annonce</label>
                    <input id="ae-titre" name="titre" type="text" class="form-control" required maxlength="200">
                </div>

                <div class="form-group">
                    <label for="ae-statut" class="form-label">Statut</label>
                    <select id="ae-statut" name="statut" class="form-select">
                        <% if (canApprove) { %>
                            <option value="PUBLISHED">Publiée</option>
                        <% } %>
                        <option value="PENDING_APPROVAL">En attente d’approbation</option>
                        <option value="ARCHIVED">Archivée</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="ae-contenu" class="form-label">Détails de l’annonce</label>
                    <textarea id="ae-contenu" name="contenu" class="form-textarea" required rows="4" maxlength="2000"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-dialog-close="annonce-edit-modal">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>
<% } %>
