<%
  const perms = typeof permissions !== 'undefined' && Array.isArray(permissions) ? permissions : [];
  const intentions = (stats && stats.allIntentions) ? stats.allIntentions : [];
  const messes = (stats && stats.allMesses) ? stats.allMesses : [];
  const statusLabels = (stats && stats.statusLabels) ? stats.statusLabels : {};

  const canProcess = perms.includes('parish.intentions.process');
  const canApprove = perms.includes('parish.intentions.approve');
  const canCelebrate = perms.includes('parish.intentions.celebrate');
%>
<div class="page-header">
    <div class="page-header-meta">
        <h1 class="page-title">Intentions de messe reçues</h1>
        <p class="page-subtitle">Cycle strict : En attente → En traitement → Acceptée → Programmée → Célébrée</p>
    </div>
    <div class="page-actions">
        <a href="/demande-intention" class="btn btn-outline">Portail public fidèles</a>
        <% if (perms.includes('parish.masses.manage')) { %>
            <a href="/page/messes" class="btn btn-gold">Ajouter une messe</a>
        <% } %>
    </div>
</div>

<div id="parish-intentions-feedback" class="alert hidden mb-4" role="status"></div>

<section class="table-card" aria-label="Liste des intentions de messe">
    <div class="table-toolbar">
        <div class="table-filters">
            <label for="intentions-search" class="sr-only">Rechercher une intention</label>
            <input
                id="intentions-search"
                type="search"
                class="form-control table-search"
                placeholder="Rechercher par référence, demandeur, objet ou date..."
                data-table-search="intentions-table-body"
            >
            <label for="intentions-status-filter" class="sr-only">Filtrer par statut</label>
            <select
                id="intentions-status-filter"
                class="form-select table-search"
                data-table-filter="intentions-table-body"
            >
                <option value="">Tous les statuts</option>
                <option value="en attente">En attente</option>
                <option value="en traitement">En traitement</option>
                <option value="acceptée">Acceptée</option>
                <option value="programmée">Programmée</option>
                <option value="célébrée">Célébrée</option>
                <option value="refusée">Refusée</option>
                <option value="annulée">Annulée</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Référence &amp; Date</th>
                    <th>Demandeur</th>
                    <th>Objet &amp; Détails</th>
                    <th>Statut</th>
                    <th>Traitement paroissial</th>
                </tr>
            </thead>
            <tbody id="intentions-table-body">
                <% if (intentions.length > 0) { %>
                    <% for (const item of intentions) { %>
                        <tr data-intention-row="<%= item.id %>">
                            <td>
                                <code><%= item.trackingRef %></code>
                                <span class="table-cell-sub">
                                    Souhaitée : <%= item.desiredDate || 'Non précisée' %><br>
                                    Reçue : <%= new Date(item.requestedAt).toLocaleDateString('fr-FR') %>
                                </span>
                            </td>
                            <td>
                                <span class="table-cell-title"><%= item.requesterName %></span>
                                <span class="table-cell-sub"><%= item.requesterPhone %></span>
                            </td>
                            <td>
                                <span class="table-cell-title"><%= item.objet %></span>
                                <span class="table-cell-sub"><%= item.details %></span>
                                <% if (item.internalComment) { %>
                                    <span class="table-cell-note">Note interne : <%= item.internalComment %></span>
                                <% } %>
                            </td>
                            <td>
                                <%- include('../partials/status_badge', { statut: item.status, label: statusLabels[item.status] || item.status }) %>
                            </td>
                            <td>
                                <% const isTerminal = ['CELEBRATED', 'REJECTED', 'CANCELLED'].includes(item.status); %>
                                <% if (!isTerminal && (canProcess || canApprove || canCelebrate)) { %>
                                    <div class="intention-workflow-box" data-intention-controls="<%= item.id %>">
                                        <% if (item.status === 'ACCEPTED' && canProcess) { %>
                                            <select class="form-select intention-messe-picker" data-intention-messe="<%= item.id %>" aria-label="Associer une messe">
                                                <option value="">Choisir une messe...</option>
                                                <% for (const m of messes) { %>
                                                    <option value="<%= m.id %>" <%= item.messeId === m.id ? 'selected' : '' %>><%= m.date %> · <%= m.horaire %> (<%= m.celebrant %>)</option>
                                                <% } %>
                                            </select>
                                        <% } %>

                                        <input
                                            type="text"
                                            class="form-control intention-comment-input"
                                            data-intention-comment="<%= item.id %>"
                                            placeholder="Note interne (invisible au fidèle)..."
                                            value="<%= item.internalComment || '' %>"
                                        >

                                        <div class="table-actions">
                                            <% if (item.status === 'PENDING' && canProcess) { %>
                                                <button type="button" class="btn btn-outline btn-sm" data-intention-transition="PROCESSING" data-intention-id="<%= item.id %>">Mettre en traitement</button>
                                            <% } %>
                                            <% if ((item.status === 'PENDING' || item.status === 'PROCESSING') && canApprove) { %>
                                                <button type="button" class="btn btn-primary btn-sm" data-intention-transition="ACCEPTED" data-intention-id="<%= item.id %>">Accepter</button>
                                                <button type="button" class="btn btn-danger btn-sm" data-intention-transition="REJECTED" data-intention-id="<%= item.id %>">Refuser</button>
                                            <% } %>
                                            <% if (item.status === 'ACCEPTED' && canProcess) { %>
                                                <button type="button" class="btn btn-gold btn-sm" data-intention-transition="SCHEDULED" data-intention-id="<%= item.id %>">Programmer sur messe</button>
                                            <% } %>
                                            <% if (item.status === 'SCHEDULED' && canCelebrate) { %>
                                                <button type="button" class="btn btn-primary btn-sm" data-intention-transition="CELEBRATED" data-intention-id="<%= item.id %>">Marquer célébrée</button>
                                            <% } %>
                                            <% if ((canProcess || canApprove) && ['PENDING', 'PROCESSING', 'ACCEPTED', 'SCHEDULED'].includes(item.status)) { %>
                                                <button type="button" class="btn btn-ghost btn-sm" data-intention-transition="CANCELLED" data-intention-id="<%= item.id %>">Annuler</button>
                                            <% } %>
                                        </div>
                                    </div>
                                <% } else { %>
                                    <span class="text-muted"><%= isTerminal ? 'Clôturée' : 'Consultation seule' %></span>
                                <% } %>
                            </td>
                        </tr>
                    <% } %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="empty-state">Aucune intention reçue pour cette paroisse.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <div id="intentions-table-body-empty" class="empty-state hidden">
        Aucune intention ne correspond à votre recherche.
    </div>
</section>
