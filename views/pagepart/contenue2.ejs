<div class="page-header">
    <div class="page-header-meta">
        <h1 class="page-title">Gestion des intentions</h1>
        <p class="page-subtitle">Déposez, modifiez et suivez l'état des intentions de messe</p>
    </div>
    <div class="page-actions">
        <a href="/page/messes" class="btn btn-gold">Ajouter une messe</a>
    </div>
</div>

<!-- Formulaire d'ajout d'intention Firestore -->
<form id="firebase-intention-form" class="card-soft mb-4">
    <h2 class="section-title mb-3">Déposer une intention de messe</h2>
    <div class="form-grid-2 mb-3">
        <div>
            <label for="intention-messe-select" class="form-label">Messe concernée</label>
            <select id="intention-messe-select" class="form-select" required>
                <option value="">Connectez-vous avec Google pour charger les messes</option>
            </select>
        </div>
        <div>
            <label for="intention-objet-input" class="form-label">Objet de l'intention</label>
            <input
                id="intention-objet-input"
                type="text"
                class="form-control"
                required
                maxlength="150"
                placeholder="Ex : Action de grâce, Repos de l'âme..."
            >
        </div>
    </div>

    <div class="form-group">
        <label for="intention-detail-input" class="form-label">Détail de l'intention</label>
        <textarea
            id="intention-detail-input"
            class="form-textarea"
            required
            maxlength="1000"
            rows="2"
            placeholder="Précisez votre intention de prière..."
        ></textarea>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Enregistrer l'intention</button>
        <span id="intention-form-feedback" class="alert hidden" role="status"></span>
    </div>
</form>

<!-- Formulaire de modification inline (owner) -->
<form id="intention-edit-form" class="card-soft card-soft-gold mb-4 hidden">
    <h3 class="mb-3">Modifier mon intention en attente</h3>
    <input id="edit-intention-id" type="hidden">
    <div class="form-group">
        <label for="edit-intention-objet" class="form-label">Objet de l'intention</label>
        <input id="edit-intention-objet" type="text" class="form-control" required maxlength="150">
    </div>
    <div class="form-group">
        <label for="edit-intention-detail" class="form-label">Détail de l'intention</label>
        <textarea id="edit-intention-detail" class="form-textarea" required maxlength="1000" rows="2"></textarea>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-gold btn-sm">Mettre à jour</button>
        <button type="button" class="btn btn-outline btn-sm" data-close-edit-form>Annuler</button>
    </div>
</form>

<!-- Tableau des intentions -->
<section class="table-card" aria-label="Liste des intentions de messe">
    <div class="table-toolbar">
        <div class="table-filters">
            <label for="intentions-search" class="sr-only">Rechercher une intention</label>
            <input
                id="intentions-search"
                type="search"
                class="form-control table-search"
                placeholder="Rechercher par date, célébrant ou objet..."
                data-table-search="intentions-table-body"
            >
            <label for="intentions-status-filter" class="sr-only">Filtrer par statut</label>
            <select
                id="intentions-status-filter"
                class="form-select table-search"
                data-table-filter="intentions-table-body"
            >
                <option value="">Tous les statuts</option>
                <option value="en attente">En attente</option>
                <option value="validé">Validé</option>
                <option value="annulée">Annulée</option>
                <option value="a venir">À venir</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Horaire</th>
                    <th>Intention &amp; Célébrant</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="intentions-table-body">
                <% const intentions = (stats && stats.allIntentions) ? stats.allIntentions : []; %>
                <% if (intentions.length > 0) { %>
                    <% for (const item of intentions) { %>
                        <tr>
                            <td><%= item.date %></td>
                            <td><%= item.horaire %></td>
                            <td><%= item.celebrant %></td>
                            <td><%- include('../partials/status_badge', { statut: item.statut }) %></td>
                            <td>
                                <span class="text-muted">Synchronisation requise</span>
                            </td>
                        </tr>
                    <% } %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="empty-state">Aucune intention enregistrée pour le moment.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <div id="intentions-table-body-empty" class="empty-state hidden">
        Aucune intention ne correspond à votre recherche.
    </div>
</section>
