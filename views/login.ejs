<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="/static/image/logomissaparo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Missa Paro - Accueil</title>
    <%- include('partials/styles') %>
</head>

<body class="auth-page">
    <main class="auth-card" aria-labelledby="welcome-title">
        <div class="auth-brand">
            <img src="/static/image/logomissaparo.png" alt="Logo Missa Paro" class="auth-logo">
            <h1 id="welcome-title" class="page-title">Bienvenue sur Missa Paro</h1>
            <p class="auth-subtitle">Portail d'administration paroissiale et espace fidèles</p>
        </div>

        <div class="form-actions">
            <a href="/" class="btn btn-primary btn-block">Se connecter à mon espace</a>
            <a href="/page/inscription" class="btn btn-secondary btn-block">Créer un compte paroisse</a>
        </div>
    </main>
</body>

</html>
