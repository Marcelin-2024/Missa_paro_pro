<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="/static/image/logomissaparo.png" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Changement obligatoire du mot de passe sur Missa Paro.">
    <title>Missa Paro - Nouveau mot de passe</title>
    <%- include('partials/styles') %>
</head>

<body class="auth-page">
    <main class="auth-card" aria-labelledby="pw-title">
        <div class="auth-brand">
            <img src="/static/image/logomissaparo.png" alt="Logo Missa Paro" class="auth-logo">
            <h1 id="pw-title" class="page-title">Définir votre mot de passe personnel</h1>
            <p class="auth-subtitle">
                Compte : <strong><%= user.email %></strong> · Minimum 8 caractères requis
            </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error mb-4" role="alert"><%= error %></div>
        <% } %>

        <form action="/page/changer-mot-de-passe" method="POST" data-loading-form>
            <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>
            <%- include('partials/input_field', { name: 'nouveau_motdepasse', label: 'Nouveau mot de passe', placeholder: 'Au moins 8 caractères', type: 'password', value: '', requit: true }) %>
            <%- include('partials/input_field', { name: 'confirmation', label: 'Confirmer le mot de passe', placeholder: 'Répétez votre mot de passe', type: 'password', value: '', requit: true }) %>
            <%- include('partials/bouton_envoi', { name: 'Valider et accéder à mon espace' }) %>
        </form>

        <div class="auth-footer">
            <a class="auth-link" href="/page/logout">Se déconnecter</a>
        </div>
    </main>

    <script src="/static/js/ui-interactions.js"></script>
</body>

</html>
