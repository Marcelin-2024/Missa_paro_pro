{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile metadata for a parish member or faithful user (no PII).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "paroisse": { "type": "string", "minLength": 1, "maxLength": 120 },
        "diocese": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["fidele", "paroisse"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "paroisse", "diocese", "role", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document for user contact details (email and phone).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "telephone": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted administrator marker document.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email", "role"]
    },
    "Parish": {
      "title": "Parish",
      "description": "Multi-tenant Catholic parish workspace in Côte d'Ivoire.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "provinceId": { "type": "string", "maxLength": 128 },
        "dioceseId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 160 },
        "status": { "type": "string", "enum": ["PENDING_ACTIVATION", "ACTIVE", "SUSPENDED", "INACTIVE"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "provinceId", "dioceseId", "name", "status", "createdAt"]
    },
    "ParishMembership": {
      "title": "ParishMembership",
      "description": "Links a user to a parish with cumulated roles (membership-scoped RBAC).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parishId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "REMOVED"] },
        "roles": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "parishId", "status", "roles", "updatedAt"]
    },
    "Messe": {
      "title": "Messe",
      "description": "Scheduled parish mass.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "minLength": 1, "maxLength": 40 },
        "horaire": { "type": "string", "minLength": 1, "maxLength": 40 },
        "celebrant": { "type": "string", "minLength": 1, "maxLength": 120 },
        "paroisse": { "type": "string", "minLength": 1, "maxLength": 120 },
        "statut": { "type": "string", "enum": ["A venir", "Passée", "Annulée"] },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "horaire", "celebrant", "paroisse", "statut", "createdBy", "createdAt"]
    },
    "Annonce": {
      "title": "Annonce",
      "description": "Parish announcement published by parish administration.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["evenement", "Deces", "Communique", "Solennite"] },
        "titre": { "type": "string", "minLength": 1, "maxLength": 200 },
        "dateAnnonce": { "type": "string", "minLength": 1, "maxLength": 40 },
        "contenu": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "titre", "dateAnnonce", "contenu", "createdBy", "createdAt"]
    },
    "Intention": {
      "title": "Intention",
      "description": "Mass intention submitted by a faithful user for a parish mass.",
      "type": "object",
      "properties": {
        "fideleId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fideleNom": { "type": "string", "minLength": 1, "maxLength": 120 },
        "messeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parishId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "messeDate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "messeHoraire": { "type": "string", "minLength": 1, "maxLength": 40 },
        "celebrant": { "type": "string", "minLength": 1, "maxLength": 120 },
        "objetIntention": { "type": "string", "minLength": 1, "maxLength": 150 },
        "detailIntention": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "statut": { "type": "string", "enum": ["en attente", "validé", "annulée"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "fideleId",
        "fideleNom",
        "messeId",
        "messeDate",
        "messeHoraire",
        "celebrant",
        "objetIntention",
        "detailIntention",
        "statut",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail for governance and parish role changes.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "maxLength": 128 },
        "scope": { "type": "string", "enum": ["GLOBAL", "PARISH", "PUBLIC"] },
        "parishId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 80 },
        "summary": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "scope", "action", "summary", "createdAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Simulated Mobile Money payment transaction linked to a mass intention and parish (no PIN or sensitive banking fields).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "transactionReference": { "type": "string", "minLength": 5, "maxLength": 64 },
        "intentionId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parishId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "faithfulUserId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "faithfulName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "faithfulPhone": { "type": "string", "minLength": 8, "maxLength": 40 },
        "provider": { "type": "string", "enum": ["WAVE", "ORANGE_MONEY", "MTN_MONEY", "MOOV_MONEY"] },
        "amount": { "type": "integer", "minimum": 500, "maximum": 500000 },
        "currency": { "type": "string", "enum": ["XOF"] },
        "status": { "type": "string", "enum": ["PENDING", "SUCCESS", "FAILED", "CANCELLED", "EXPIRED"] },
        "simulationMode": { "type": "boolean" },
        "attemptNumber": { "type": "integer", "minimum": 1 },
        "failureReason": { "type": "string", "maxLength": 300 },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "transactionReference",
        "intentionId",
        "parishId",
        "faithfulName",
        "faithfulPhone",
        "provider",
        "amount",
        "currency",
        "status",
        "simulationMode",
        "attemptNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentEvent": {
      "title": "PaymentEvent",
      "description": "Immutable status transition event log for a simulated payment transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "paymentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parishId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "eventType": { "type": "string", "maxLength": 60 },
        "previousStatus": { "type": "string", "maxLength": 30 },
        "newStatus": { "type": "string", "enum": ["PENDING", "SUCCESS", "FAILED", "CANCELLED", "EXPIRED"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "paymentId", "parishId", "eventType", "newStatus", "description", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile summary documents keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/info": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection document for a user's email and phone."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Read-only admin role marker collection."
    },
    "/parishes/{parishId}": {
      "schema": { "$ref": "#/entities/Parish" },
      "description": "Multi-tenant parish directory and status records."
    },
    "/parishMemberships/{membershipId}": {
      "schema": { "$ref": "#/entities/ParishMembership" },
      "description": "Parish-scoped memberships and cumulated roles."
    },
    "/messes/{messeId}": {
      "schema": { "$ref": "#/entities/Messe" },
      "description": "Scheduled parish masses."
    },
    "/annonces/{annonceId}": {
      "schema": { "$ref": "#/entities/Annonce" },
      "description": "Published parish announcements."
    },
    "/intentions/{intentionId}": {
      "schema": { "$ref": "#/entities/Intention" },
      "description": "Mass intentions submitted by faithful users."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only governance and role audit logs."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Simulated Mobile Money payments attached to mass intentions and parishes."
    },
    "/paymentEvents/{eventId}": {
      "schema": { "$ref": "#/entities/PaymentEvent" },
      "description": "Append-only event history for simulated payment status changes."
    }
  }
}
