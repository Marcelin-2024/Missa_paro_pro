rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Zero-Trust Default-Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Connection health check for Firebase Web SDK (testConnection)
    match /test/connection {
      allow get: if isSignedIn();
    }

    // All business and session collections are strictly server-managed via Firebase Admin SDK
    match /systemMetadata/{docId} {
      allow read, write: if false;
    }

    match /platformSettings/{docId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /parishes/{parishId} {
      allow read, write: if false;
    }

    match /parishMemberships/{membershipId} {
      allow read, write: if false;
    }

    match /membershipRoles/{roleId} {
      allow read, write: if false;
    }

    match /messes/{messeId} {
      allow read, write: if false;
    }

    match /annonces/{annonceId} {
      allow read, write: if false;
    }

    match /intentions/{intentionId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /parishRequests/{requestId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    match /sessions/{sid} {
      allow read, write: if false;
    }

    match /contacts/{contactId} {
      allow read, write: if false;
    }

    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    match /pushTokens/{tokenId} {
      allow read, write: if false;
    }

    match /loginAttempts/{keyHash} {
      allow read, write: if false;
    }
  }
}
